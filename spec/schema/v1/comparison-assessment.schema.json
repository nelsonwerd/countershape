{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/comparison-assessment.schema.json",
  "title": "Countershape ComparisonAssessment v1",
  "description": "Persisted result of applying one ComparisonEnvelope to one exact complete candidate measurement matrix for one stimulus and purpose. A caller-selected status is never an admission constructor. The derived comparison_basis_digest excludes stimulus and purpose so it can identify a reusable preservation-comparability basis; the assessment artifact digest does not.",
  "oneOf": [
    {
      "title": "Countershape ComparisonAdmission v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "artifact_digest", "world_plan_digest",
        "comparison_envelope_digest", "comparison_basis_digest", "measurement_digests", "measurement_order",
        "candidate_roster", "required_and_rejected_equal_basis", "nonclaim"
      ],
      "properties": {
        "schema_version": { "const": "countershape/v1" },
        "kind": { "const": "ComparisonAdmission" },
        "artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "world_plan_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "comparison_envelope_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "comparison_basis_digest": {
          "description": "Derived identity of world plan, comparison envelope, exact roster, and required/rejected equality basis. It deliberately excludes stimulus, purpose, measurement rows, and per-run admission artifact identity.",
          "$ref": "common.schema.json#/$defs/Digest"
        },
        "measurement_digests": {
          "description": "Exact complete measurement matrix in candidate-roster order. Semantic construction requires one digest per roster member and therefore gives each concrete comparison matrix a unique artifact digest.",
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Digest" }
        },
        "measurement_order": { "const": "CANDIDATE_EXECUTION_KEY_UTF8_LEXICOGRAPHIC" },
        "candidate_roster": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" }
        },
        "required_and_rejected_equal_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "canonical_json"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "canonical_json": { "type": "string", "minLength": 1 }
            }
          }
        },
        "nonclaim": { "const": "BEHAVIORAL_COMPATIBILITY_NOT_ESTABLISHED" }
      }
    },
    {
      "title": "Countershape RejectedComparison v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "kind", "artifact_digest", "world_plan_digest",
        "comparison_envelope_digest", "measurement_digests", "reason_codes"
      ],
      "properties": {
        "schema_version": { "const": "countershape/v1" },
        "kind": { "const": "RejectedComparison" },
        "artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "world_plan_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "comparison_envelope_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "measurement_digests": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Digest" }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
