{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/finalized-contract-run.schema.json",
  "title": "Countershape FinalizedContractRun v1",
  "description": "Inert canonical body for one immutable target-bound physical-run conclusion. Process, projection, and five-domain scope remain separate closed axes; disposition is derived and is not serialized.",
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "MATERIALIZATION_REVALIDATION",
        "RUNTIME_REVALIDATION",
        "PROCESS_RESULT",
        "WAIT_RESULT",
        "DRAIN_RESULT",
        "TEARDOWN_RESULT",
        "ORPHAN_CHECK",
        "FINALIZATION_MARKER",
        "CAPTURED_OBSERVATION",
        "PROJECTION_RESULT",
        "TARGET_INVENTORY",
        "CHILD_BINDINGS",
        "IMPORT_RESOLUTION",
        "SERVICE_BINDINGS",
        "NAMED_PARENT_SECRET_SENTINEL_INHERITANCE",
        "PRIVATE_EVIDENCE_MANIFEST"
      ]
    },
    "EvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/EvidenceKind" },
        "digest": { "$ref": "common.schema.json#/$defs/Digest" }
      }
    },
    "CapturedObservationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "const": "CAPTURED_OBSERVATION" },
        "digest": { "$ref": "common.schema.json#/$defs/Digest" }
      }
    },
    "ProjectionResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "const": "PROJECTION_RESULT" },
        "digest": { "$ref": "common.schema.json#/$defs/Digest" }
      }
    },
    "SpawnObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_code"],
          "properties": {
            "status": { "const": "START_ERROR" },
            "error_code": {
              "enum": [
                "OS_START_ERROR",
                "PRESPAWN_MATERIALIZATION_REVALIDATION_FAILED",
                "PRESPAWN_RUNTIME_REVALIDATION_FAILED"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "pid"],
          "properties": {
            "status": { "const": "CHILD_PID_OBSERVED" },
            "pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      ]
    },
    "ProcessClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "primary_reason", "cleanup_controls", "evidence_refs"],
      "properties": {
        "status": { "enum": ["PROCESS_CLEAN", "PROCESS_CONTROLLED"] },
        "primary_reason": {
          "enum": [
            "NONE",
            "MATERIALIZATION_ERROR",
            "START_ERROR",
            "READINESS_ERROR",
            "PROBE_TRANSPORT_ERROR",
            "TIMEOUT",
            "CANCELLED",
            "OUTPUT_LIMIT",
            "PROJECTION_REJECTED"
          ]
        },
        "cleanup_controls": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["TEARDOWN_ERROR", "ORPHAN_RISK"] }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/EvidenceRef" }
        }
      }
    },
    "CaptureProjection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "NO_CAPTURE" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "captured_observation_ref"],
          "properties": {
            "status": { "const": "CAPTURED_UNPROJECTED" },
            "captured_observation_ref": { "$ref": "#/$defs/CapturedObservationRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "captured_observation_ref", "projection_result_ref", "observed_tuple"],
          "properties": {
            "status": { "const": "PROJECTED" },
            "captured_observation_ref": { "$ref": "#/$defs/CapturedObservationRef" },
            "projection_result_ref": { "$ref": "#/$defs/ProjectionResultRef" },
            "observed_tuple": { "$ref": "common.schema.json#/$defs/ExactTuple" }
          }
        }
      ]
    },
    "ScopeCheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "status", "evidence_ref"],
          "properties": {
            "domain": { "enum": ["TARGET_INVENTORY", "CHILD_BINDINGS", "IMPORT_RESOLUTION", "SERVICE_BINDINGS", "NAMED_PARENT_SECRET_SENTINEL_INHERITANCE"] },
            "status": { "const": "PRESENT_CLEAN" },
            "evidence_ref": { "$ref": "#/$defs/EvidenceRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "status"],
          "properties": {
            "domain": { "enum": ["TARGET_INVENTORY", "CHILD_BINDINGS", "IMPORT_RESOLUTION", "SERVICE_BINDINGS", "NAMED_PARENT_SECRET_SENTINEL_INHERITANCE"] },
            "status": { "const": "MISSING" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "status", "evidence_ref", "violation"],
          "properties": {
            "domain": { "enum": ["TARGET_INVENTORY", "CHILD_BINDINGS", "IMPORT_RESOLUTION", "SERVICE_BINDINGS", "NAMED_PARENT_SECRET_SENTINEL_INHERITANCE"] },
            "status": { "const": "PRESENT_VIOLATION" },
            "evidence_ref": { "$ref": "#/$defs/EvidenceRef" },
            "violation": {
              "enum": [
                "COUNTERSHAPE_SOURCE_PRESENT",
                "COUNTERSHAPE_DEPENDENCY_PRESENT",
                "COUNTERSHAPE_SOURCE_AND_DEPENDENCY_PRESENT",
                "CHILD_BINDING_REACHES_COUNTERSHAPE",
                "IMPORT_RESOLUTION_REACHES_COUNTERSHAPE",
                "COUNTERSHAPE_SERVICE_BINDING_PRESENT",
                "NAMED_PARENT_SECRET_SENTINEL_INHERITED"
              ]
            }
          }
        }
      ]
    },
    "StandaloneScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["COMPLETE", "PARTIAL", "VIOLATED"] },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/ScopeCheck" }
        }
      }
    },
    "PrivateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "manifest_ref", "blob_count", "aggregate_byte_count", "retention_at_finalization", "default_export"],
      "properties": {
        "profile": { "const": "PRIVATE_EVIDENCE_MANIFEST_V1" },
        "manifest_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "digest"],
          "properties": {
            "kind": { "const": "PRIVATE_EVIDENCE_MANIFEST" },
            "digest": { "$ref": "common.schema.json#/$defs/Digest" }
          }
        },
        "blob_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "aggregate_byte_count": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "retention_at_finalization": { "const": "RETAINED_AT_FINALIZATION" },
        "default_export": { "const": "OMITTED" }
      }
    },
    "ClosedRunWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["witness_version", "spawn_observation", "process_closure", "observation", "standalone_scope", "private_evidence"],
      "properties": {
        "witness_version": { "const": "closed-run-witness/v1" },
        "spawn_observation": { "$ref": "#/$defs/SpawnObservation" },
        "process_closure": { "$ref": "#/$defs/ProcessClosure" },
        "observation": { "$ref": "#/$defs/CaptureProjection" },
        "standalone_scope": { "$ref": "#/$defs/StandaloneScope" },
        "private_evidence": { "$ref": "#/$defs/PrivateEvidence" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_version",
    "publication_scope",
    "contract_execution_target_digest",
    "attempt_artifact_digest",
    "start_claim_ref",
    "closed_run_witness"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "FinalizedContractRun" },
    "run_version": { "const": "finalized-contract-run/v1" },
    "publication_scope": { "const": "IMMUTABLE_NONHEAD_FINALIZED_RUN_V1" },
    "contract_execution_target_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "attempt_artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "start_claim_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": { "const": "StartClaim" },
        "digest": { "$ref": "common.schema.json#/$defs/Digest" }
      }
    },
    "closed_run_witness": { "$ref": "#/$defs/ClosedRunWitness" }
  }
}
