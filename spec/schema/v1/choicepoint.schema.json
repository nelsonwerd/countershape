{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/choicepoint.schema.json",
  "title": "Countershape Choicepoint v1",
  "description": "The exact 27-member U6 Choicepoint archive body. Its domain-separated digest is external to these bytes. JSON Schema checks inert wire shape only; Countershape's strict Go reconstruction is the authority for nested bytes, digests, roster equality, fresh confirmation, and readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "scenario",
    "world_plan_base64",
    "world_plan_digest",
    "comparison_envelope_base64",
    "comparison_envelope_digest",
    "projection_binding_base64",
    "projection_definition_digest",
    "candidate_bindings_base64",
    "candidate_execution_keys",
    "candidate_reveals",
    "original_stimulus_kind",
    "original_stimulus_base64",
    "original_stimulus_digest",
    "minimized_stimulus_kind",
    "minimized_stimulus_base64",
    "minimized_stimulus_digest",
    "fresh_confirmation_base64",
    "fresh_confirmation_digest",
    "confirmed_outcome_map_digest",
    "confirmed_preservation_map_digest",
    "choice_projection_mode",
    "evidence_receipts",
    "evidence_status_when_empty",
    "readiness_scope",
    "presentation_provenance_nonclaim"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "Choicepoint" },
    "scenario": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "world_plan_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "world_plan_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "comparison_envelope_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "comparison_envelope_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "projection_binding_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "projection_definition_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "candidate_bindings_base64": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/NonemptyBase64" }
    },
    "candidate_execution_keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" }
    },
    "candidate_reveals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/CandidateReveal" }
    },
    "original_stimulus_kind": { "enum": ["CLIStimulus", "HTTPStimulus"] },
    "original_stimulus_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "original_stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "minimized_stimulus_kind": { "enum": ["CLIStimulus", "HTTPStimulus"] },
    "minimized_stimulus_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "minimized_stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "fresh_confirmation_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "fresh_confirmation_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "confirmed_outcome_map_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "confirmed_preservation_map_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "choice_projection_mode": { "const": "WHOLE_EXACT_CANONICAL_PROJECTION_V1" },
    "evidence_receipts": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ReceiptReference" }
    },
    "evidence_status_when_empty": { "const": "UNRECEIPTED" },
    "readiness_scope": { "const": "EXACT_FRESH_CONFIRMED_WITNESS_V1" },
    "presentation_provenance_nonclaim": {
      "const": "DISPLAY_REFS_AND_PRODUCER_METADATA_ARE_REVEAL_ONLY_NONEXECUTION_PROVENANCE"
    }
  },
  "$defs": {
    "NonemptyBase64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "CandidateReveal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_execution_key", "display_ref", "producer_metadata"],
      "properties": {
        "candidate_execution_key": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" },
        "display_ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "producer_metadata": { "type": "string", "maxLength": 2048 }
      }
    }
  }
}
