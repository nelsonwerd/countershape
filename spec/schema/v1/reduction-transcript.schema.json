{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/reduction-transcript.schema.json",
  "title": "Countershape ReductionTranscript v1 canonical body",
  "description": "The exact semantic-body field set emitted by internal/reduce for deterministic proposal accounting and inert replay provenance. The transcript commits to typed baseline map identities plus its four evidence-domain lists, but executable replay additionally requires the matching compare-owned DivergentBaseline authority. OutcomeArtifactDigest and PreservationMapDigest remain distinct fields. An observed entry may still be UNRESOLVED when comparability fails. Parsing this JSON cannot reconstruct typed Evaluation values, captured evidence, physical freshness, or execution authority.",
  "$comment": "Sorted baseline evidence, cross-entry evidence nonreuse, counter deltas, accepted-path and parent-chain derivation, reserved protocol-refusal and terminal final-sweep decision/limitation rules, measure-digest reconstruction, final-sweep reachability, lexical final-neighbor order, and the sole terminal evaluator-overrun exception to the configured trial limit are enforced by the owning parser rather than established by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "reducer_set_digest",
    "measure_definition_digest",
    "scope_digest",
    "baseline_outcome_map_digest",
    "baseline_preservation_map_digest",
    "baseline_batch_digests",
    "baseline_attempt_digests",
    "baseline_world_digests",
    "baseline_observation_digests",
    "proposal_limit",
    "candidate_trial_limit",
    "wall_limit_ms",
    "entries",
    "accepted_proposal_digests",
    "limitations",
    "final_sweep_state",
    "final_neighbor_digests"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "ReductionTranscript" },
    "reducer_set_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "measure_definition_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "scope_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "baseline_outcome_map_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "baseline_preservation_map_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "baseline_batch_digests": { "$ref": "#/$defs/NonemptyDigestList" },
    "baseline_attempt_digests": { "$ref": "#/$defs/NonemptyDigestList" },
    "baseline_world_digests": { "$ref": "#/$defs/NonemptyDigestList" },
    "baseline_observation_digests": { "$ref": "#/$defs/NonemptyDigestList" },
    "proposal_limit": { "type": "integer", "minimum": 1, "maximum": 200 },
    "candidate_trial_limit": { "type": "integer", "minimum": 1, "maximum": 2000 },
    "wall_limit_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/EvaluationEntry" }
    },
    "accepted_proposal_digests": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "final_sweep_state": { "enum": ["COMPLETE", "INCOMPLETE", "NOT_RUN"] },
    "final_neighbor_digests": {
      "description": "A complete transcript carries the lexically sorted exact final-neighbor stimulus set; incomplete and unrun transcripts carry an empty array.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    }
  },
  "$defs": {
    "MeasureComponents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    },
    "DigestList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "NonemptyDigestList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "EvaluationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id",
        "proposal_digest",
        "parent_stimulus_digest",
        "neighbor_stimulus_digest",
        "before_measure_digest",
        "before_measure_components",
        "after_measure_digest",
        "after_measure_components",
        "rule_name",
        "rule_version",
        "locus",
        "transform_priority",
        "purpose",
        "decision",
        "reason_code",
        "observed_outcome_map_digest",
        "observed_preservation_map_digest",
        "batch_digests",
        "attempt_digests",
        "world_digests",
        "observation_digests",
        "proposal_count",
        "total_candidate_trials",
        "candidate_trials"
      ],
      "properties": {
        "evaluation_id": { "type": "string", "minLength": 1 },
        "proposal_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "parent_stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "neighbor_stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "before_measure_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "before_measure_components": { "$ref": "#/$defs/MeasureComponents" },
        "after_measure_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "after_measure_components": { "$ref": "#/$defs/MeasureComponents" },
        "rule_name": { "type": "string", "minLength": 1 },
        "rule_version": { "type": "string", "minLength": 1 },
        "locus": { "type": "string", "minLength": 1, "maxLength": 256 },
        "transform_priority": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "purpose": { "enum": ["REDUCTION", "FINAL_SWEEP"] },
        "decision": { "enum": ["PRESERVES", "CHANGES", "UNRESOLVED"] },
        "reason_code": {
          "enum": [
            "EXACT_PRESERVATION_MAP_MATCH",
            "EXACT_PRESERVATION_MAP_CHANGED",
            "CANDIDATE_ELIGIBILITY_OR_ADMISSION_CHANGED",
            "TIMEOUT",
            "CANCELLED",
            "STALE",
            "UNSTABLE",
            "INCOMPLETE",
            "TEARDOWN_ERROR",
            "EVALUATOR_ERROR",
            "WALL_BUDGET_EXHAUSTED",
            "REDUCTION_CANCELLED",
            "NO_OBSERVATION",
            "EVALUATOR_EXCEEDED_CANDIDATE_TRIAL_BUDGET",
            "OBSERVED_MAP_WITHOUT_CANDIDATE_TRIALS",
            "UNRESOLVED_EVALUATION_MISSING_EVIDENCE",
            "INVALID_EVALUATOR_RESULT",
            "REUSED_EVALUATION_EVIDENCE"
          ]
        },
        "observed_outcome_map_digest": { "type": "string" },
        "observed_preservation_map_digest": { "type": "string" },
        "batch_digests": { "$ref": "#/$defs/DigestList" },
        "attempt_digests": { "$ref": "#/$defs/DigestList" },
        "world_digests": { "$ref": "#/$defs/DigestList" },
        "observation_digests": { "$ref": "#/$defs/DigestList" },
        "proposal_count": { "type": "integer", "minimum": 1, "maximum": 200 },
        "total_candidate_trials": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "candidate_trials": { "type": "integer", "minimum": 0, "maximum": 2000 }
      },
      "oneOf": [
        {
          "properties": {
            "observed_outcome_map_digest": { "$ref": "common.schema.json#/$defs/Digest" },
            "observed_preservation_map_digest": { "$ref": "common.schema.json#/$defs/Digest" },
            "batch_digests": { "minItems": 1 },
            "attempt_digests": { "minItems": 1 },
            "world_digests": { "minItems": 1 },
            "observation_digests": { "minItems": 1 }
          }
        },
        {
          "properties": {
            "decision": { "const": "UNRESOLVED" },
            "observed_outcome_map_digest": { "const": "" },
            "observed_preservation_map_digest": { "const": "" },
            "batch_digests": { "maxItems": 0 },
            "attempt_digests": { "maxItems": 0 },
            "world_digests": { "maxItems": 0 },
            "observation_digests": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "decision": { "const": "UNRESOLVED" },
            "observed_outcome_map_digest": { "const": "" },
            "observed_preservation_map_digest": { "const": "" },
            "batch_digests": { "minItems": 1 },
            "attempt_digests": { "minItems": 1 },
            "world_digests": { "minItems": 1 },
            "observation_digests": { "minItems": 1 }
          }
        }
      ]
    }
  }
}
