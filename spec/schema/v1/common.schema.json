{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/common.schema.json",
  "title": "Countershape v1 shared schema definitions",
  "description": "Shared syntax for inert Countershape contract examples. These schemas do not establish runtime canonicalization or semantic correctness.",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "CandidateExecutionKey": {
      "type": "string",
      "pattern": "^candidate:[0-9a-f]{64}$"
    },
    "ProjectionFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "AttemptPurpose": {
      "enum": ["DISCOVERY", "REDUCTION", "FINAL_SWEEP", "CONFIRMATION", "CONFORMANCE"]
    },
    "ArtifactKind": {
      "enum": [
        "WorldPlan",
        "CandidateExecutionBinding",
        "WorldInstance",
        "InstanceMeasurements",
        "ComparisonEnvelope",
        "ComparisonAdmission",
        "RejectedComparison",
        "CapturedObservation",
        "StableBatch",
        "CandidateOutcomeMap",
        "ReductionRun",
        "Choicepoint",
        "DecisionRecord",
        "ContractBundle",
        "ContractExecutionTarget",
        "FinalizedContractRun",
        "ContractExecution"
      ]
    },
    "ControlReason": {
      "enum": [
        "MATERIALIZATION_ERROR",
        "SETUP_ERROR",
        "START_ERROR",
        "READINESS_ERROR",
        "PROBE_TRANSPORT_ERROR",
        "TIMEOUT",
        "CANCELLED",
        "OUTPUT_LIMIT",
        "PROJECTION_REJECTED",
        "ORPHAN_RISK",
        "TEARDOWN_ERROR",
        "ENVELOPE_REJECTED",
        "UNSUPPORTED_GIT_MODE",
        "MISSING_OBJECT",
        "BUDGET_EXHAUSTED"
      ]
    },
    "FieldId": {
      "enum": [
        "http.status",
        "http.header.content-type",
        "http.body.kind",
        "http.body.metadata",
        "cli.completion.kind",
        "cli.exit.code",
        "cli.exit.signal",
        "cli.stdout.bytes",
        "cli.stdout.json.mode",
        "cli.stdout.json.source",
        "cli.stderr.text"
      ]
    },
    "ExactValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag"],
          "properties": {
            "tag": { "const": "MISSING" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": {
            "tag": { "const": "STRING" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "canonical"],
          "properties": {
            "tag": { "const": "INTEGER" },
            "canonical": {
              "type": "string",
              "pattern": "^(?:0|-?(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[01][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]|900719925474099[01]))$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "value"],
          "properties": {
            "tag": { "const": "BOOLEAN" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag"],
          "properties": {
            "tag": { "const": "NULL" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "base64"],
          "properties": {
            "tag": { "const": "BYTES" },
            "base64": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "values"],
          "properties": {
            "tag": { "const": "ORDERED_STRING_LIST" },
            "values": {
              "type": "array",
              "maxItems": 256,
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "canonical_base64"],
          "properties": {
            "tag": { "const": "CANONICAL_JSON" },
            "canonical_base64": {
              "type": "string",
              "minLength": 4,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          }
        }
      ]
    },
    "ExactField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "value"],
      "properties": {
        "field_id": { "$ref": "#/$defs/FieldId" },
        "value": { "$ref": "#/$defs/ExactValue" }
      }
    },
    "ExactTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ExactField" }
        }
      }
    },
    "Channel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "state", "byte_digest", "byte_count"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "state": { "const": "PRESENT" },
            "byte_digest": { "$ref": "#/$defs/Digest" },
            "byte_count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "state", "reason"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "state": { "const": "ABSENT" },
            "reason": {
              "enum": ["NOT_PRODUCED", "NOT_CAPTURED_BY_POLICY", "NOT_APPLICABLE"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "state", "retained_digest", "retained_byte_count", "limit_byte_count"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "state": { "const": "TRUNCATED" },
            "retained_digest": { "$ref": "#/$defs/Digest" },
            "retained_byte_count": { "type": "integer", "minimum": 0 },
            "limit_byte_count": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "ReceiptReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "grade_verbatim", "commit_oid", "command_digest"],
      "properties": {
        "authority": { "const": "didrun" },
        "grade_verbatim": { "type": "string", "minLength": 1 },
        "commit_oid": { "type": "string", "minLength": 1 },
        "command_digest": { "$ref": "#/$defs/Digest" }
      }
    }
  }
}
