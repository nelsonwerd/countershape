{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/decision-record.schema.json",
  "title": "Countershape DecisionRecord v1",
  "description": "The exact 40-member U6 DecisionRecord archive body. Its digest is external to these bytes. Serialized compilability is a reconstructed projection, never emitter authority; strict Go reconstruction against the exact Choicepoint is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "choicepoint_digest",
    "blind_payload_digest",
    "original_stimulus_digest",
    "minimized_stimulus_digest",
    "scope",
    "generalization_claimed",
    "provisional_ruling_base64",
    "provisional_ruling_digest",
    "provisional_action",
    "final_ruling_base64",
    "final_ruling_digest",
    "reveal_base64",
    "reveal_digest",
    "early_reveal",
    "changed_after_reveal",
    "post_reveal_change_rationale",
    "visited_surfaces",
    "pre_reveal_visited_surfaces",
    "post_reveal_visited_surfaces",
    "presentation_fact_scope",
    "actor_id",
    "actor_attribution",
    "actor_authenticity",
    "human_annotation",
    "action",
    "selected_fields",
    "nonasserted_fields",
    "allowed_aliases",
    "confirmed_allowed_outcome_ids",
    "confirmed_disallowed_outcome_ids",
    "allowed_complete_tuples",
    "disallowed_complete_tuples",
    "separation_check",
    "compile_eligibility",
    "compilable",
    "didrun_receipts",
    "receipt_status_when_empty",
    "receipt_interpretation"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "DecisionRecord" },
    "choicepoint_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "blind_payload_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "original_stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "minimized_stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "scope": { "const": "EXACT_WITNESSED_STIMULUS_V1" },
    "generalization_claimed": { "const": false },
    "provisional_ruling_base64": { "$ref": "#/$defs/OptionalBase64" },
    "provisional_ruling_digest": {
      "oneOf": [
        { "const": "" },
        { "$ref": "common.schema.json#/$defs/Digest" }
      ]
    },
    "provisional_action": {
      "oneOf": [
        { "const": "" },
        { "$ref": "#/$defs/Action" }
      ]
    },
    "final_ruling_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "final_ruling_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "reveal_base64": { "$ref": "#/$defs/NonemptyBase64" },
    "reveal_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "early_reveal": { "type": "boolean" },
    "changed_after_reveal": { "type": "boolean" },
    "post_reveal_change_rationale": { "type": "string", "maxLength": 8192 },
    "visited_surfaces": {
      "const": [
        "ORIGINAL_WITNESS",
        "MINIMIZED_WITNESS",
        "REDUCTION_DERIVATION",
        "PROJECTION_OPERATIONS",
        "NONASSERTED_FIELDS",
        "PROVENANCE_REVEAL"
      ]
    },
    "pre_reveal_visited_surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/PreRevealSurface" }
    },
    "post_reveal_visited_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ReviewSurface" }
    },
    "presentation_fact_scope": { "const": "PRESENTED_NOT_COMPREHENDED_OR_DEBIASED" },
    "actor_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "actor_attribution": { "const": "LOCAL_CALLER_ASSERTED_OPERATOR" },
    "actor_authenticity": { "const": "AUTHENTICITY_NOT_ESTABLISHED_IN_U6" },
    "human_annotation": { "type": "string", "maxLength": 32768 },
    "action": {
      "enum": ["ALLOW_OBSERVED", "CUSTOM_EXPECTATION", "REJECT_ALL", "DEFER", "REFINE"]
    },
    "selected_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/FieldID" }
    },
    "nonasserted_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/FieldID" }
    },
    "allowed_aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/BlindAlias" }
    },
    "confirmed_allowed_outcome_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/OutcomeID" }
    },
    "confirmed_disallowed_outcome_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/OutcomeID" }
    },
    "allowed_complete_tuples": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExactTuple" }
    },
    "disallowed_complete_tuples": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExactTuple" }
    },
    "separation_check": { "$ref": "#/$defs/SeparationCheck" },
    "compile_eligibility": {
      "enum": ["COMPILE_ELIGIBLE_EXACT_PREDICATE", "NONCOMPILABLE_ACTION"]
    },
    "compilable": { "type": "boolean" },
    "didrun_receipts": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ReceiptReference" }
    },
    "receipt_status_when_empty": { "const": "UNRECEIPTED" },
    "receipt_interpretation": { "const": "OPAQUE_VERBATIM_REFERENCE_NOT_CONFORMANCE" }
  },
  "$defs": {
    "Action": {
      "enum": ["ALLOW_OBSERVED", "CUSTOM_EXPECTATION", "REJECT_ALL", "DEFER", "REFINE"]
    },
    "ReviewSurface": {
      "enum": [
        "ORIGINAL_WITNESS",
        "MINIMIZED_WITNESS",
        "REDUCTION_DERIVATION",
        "PROJECTION_OPERATIONS",
        "NONASSERTED_FIELDS",
        "PROVENANCE_REVEAL"
      ]
    },
    "PreRevealSurface": {
      "enum": [
        "ORIGINAL_WITNESS",
        "MINIMIZED_WITNESS",
        "REDUCTION_DERIVATION",
        "PROJECTION_OPERATIONS",
        "NONASSERTED_FIELDS"
      ]
    },
    "FieldID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "BlindAlias": {
      "type": "string",
      "pattern": "^blind:[0-9a-f]{64}$"
    },
    "OutcomeID": {
      "type": "string",
      "pattern": "^outcome:[0-9a-f]{64}$"
    },
    "OptionalBase64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "NonemptyBase64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "ExactValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "text", "boolean", "canonical_json_base64"],
      "properties": {
        "tag": { "enum": ["MISSING", "STRING", "INTEGER", "BOOLEAN", "NULL", "CANONICAL_JSON"] },
        "text": { "type": "string" },
        "boolean": { "type": "boolean" },
        "canonical_json_base64": { "$ref": "#/$defs/OptionalBase64" }
      },
      "allOf": [
        {
          "if": { "properties": { "tag": { "const": "MISSING" } }, "required": ["tag"] },
          "then": { "properties": { "text": { "const": "" }, "boolean": { "const": false }, "canonical_json_base64": { "const": "" } } }
        },
        {
          "if": { "properties": { "tag": { "const": "NULL" } }, "required": ["tag"] },
          "then": { "properties": { "text": { "const": "" }, "boolean": { "const": false }, "canonical_json_base64": { "const": "" } } }
        },
        {
          "if": { "properties": { "tag": { "enum": ["STRING", "INTEGER"] } }, "required": ["tag"] },
          "then": { "properties": { "boolean": { "const": false }, "canonical_json_base64": { "const": "" } } }
        },
        {
          "if": { "properties": { "tag": { "const": "BOOLEAN" } }, "required": ["tag"] },
          "then": { "properties": { "text": { "const": "" }, "canonical_json_base64": { "const": "" } } }
        },
        {
          "if": { "properties": { "tag": { "const": "CANONICAL_JSON" } }, "required": ["tag"] },
          "then": { "properties": { "text": { "const": "" }, "boolean": { "const": false }, "canonical_json_base64": { "$ref": "#/$defs/NonemptyBase64" } } }
        }
      ]
    },
    "ExactField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_id", "value"],
      "properties": {
        "field_id": { "$ref": "#/$defs/FieldID" },
        "value": { "$ref": "#/$defs/ExactValue" }
      }
    },
    "ExactTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ExactField" }
        }
      }
    },
    "SeparationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "allowed_tuple_count",
        "disallowed_tuple_count",
        "allowed_outcome_count",
        "disallowed_outcome_count",
        "compared_pair_count"
      ],
      "properties": {
        "status": { "enum": ["PASSED", "NOT_APPLICABLE"] },
        "allowed_tuple_count": { "type": "integer", "minimum": 0 },
        "disallowed_tuple_count": { "type": "integer", "minimum": 0 },
        "allowed_outcome_count": { "type": "integer", "minimum": 0 },
        "disallowed_outcome_count": { "type": "integer", "minimum": 0 },
        "compared_pair_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "early_reveal": { "const": true } }, "required": ["early_reveal"] },
      "then": {
        "properties": {
          "provisional_ruling_base64": { "const": "" },
          "provisional_ruling_digest": { "const": "" },
          "provisional_action": { "const": "" }
        }
      }
    },
    {
      "if": { "properties": { "early_reveal": { "const": false } }, "required": ["early_reveal"] },
      "then": {
        "properties": {
          "provisional_ruling_base64": { "$ref": "#/$defs/NonemptyBase64" },
          "provisional_ruling_digest": { "$ref": "common.schema.json#/$defs/Digest" },
          "provisional_action": { "$ref": "#/$defs/Action" },
          "pre_reveal_visited_surfaces": {
            "const": [
              "ORIGINAL_WITNESS",
              "MINIMIZED_WITNESS",
              "REDUCTION_DERIVATION",
              "PROJECTION_OPERATIONS",
              "NONASSERTED_FIELDS"
            ]
          },
          "post_reveal_visited_surfaces": { "const": ["PROVENANCE_REVEAL"] }
        }
      }
    },
    {
      "if": { "properties": { "changed_after_reveal": { "const": true } }, "required": ["changed_after_reveal"] },
      "then": {
        "properties": {
          "early_reveal": { "const": false },
          "post_reveal_change_rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "changed_after_reveal": { "const": false } }, "required": ["changed_after_reveal"] },
      "then": {
        "properties": { "post_reveal_change_rationale": { "const": "" } }
      }
    },
    {
      "if": { "properties": { "action": { "enum": ["ALLOW_OBSERVED", "CUSTOM_EXPECTATION"] } }, "required": ["action"] },
      "then": {
        "properties": {
          "selected_fields": { "minItems": 1 },
          "allowed_complete_tuples": { "minItems": 1 },
          "separation_check": { "properties": { "status": { "const": "PASSED" } }, "required": ["status"] },
          "compile_eligibility": { "const": "COMPILE_ELIGIBLE_EXACT_PREDICATE" },
          "compilable": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "action": { "enum": ["REJECT_ALL", "DEFER", "REFINE"] } }, "required": ["action"] },
      "then": {
        "properties": {
          "selected_fields": { "maxItems": 0 },
          "allowed_aliases": { "maxItems": 0 },
          "confirmed_allowed_outcome_ids": { "maxItems": 0 },
          "confirmed_disallowed_outcome_ids": { "maxItems": 0 },
          "allowed_complete_tuples": { "maxItems": 0 },
          "disallowed_complete_tuples": { "maxItems": 0 },
          "separation_check": {
            "properties": {
              "status": { "const": "NOT_APPLICABLE" },
              "allowed_tuple_count": { "const": 0 },
              "disallowed_tuple_count": { "const": 0 },
              "allowed_outcome_count": { "const": 0 },
              "disallowed_outcome_count": { "const": 0 },
              "compared_pair_count": { "const": 0 }
            }
          },
          "compile_eligibility": { "const": "NONCOMPILABLE_ACTION" },
          "compilable": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "ALLOW_OBSERVED" } }, "required": ["action"] },
      "then": { "properties": { "allowed_aliases": { "minItems": 1 } } }
    }
  ]
}
