{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/world-instance.schema.json",
  "title": "Countershape WorldInstance v1",
  "description": "Structural declared-consistency identity for one attempt. It binds plan, opaque candidate binding, stimulus, attempt, purpose, nonce, and ordinal; it contains no caller-selected admission and establishes no host truth or physical freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "artifact_digest", "world_plan_digest", "candidate_execution_key",
    "candidate_execution_binding_digest", "stimulus_digest", "attempt_artifact_digest",
    "attempt_purpose", "instance_nonce", "schedule_ordinal"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "WorldInstance" },
    "artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "world_plan_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "candidate_execution_key": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" },
    "candidate_execution_binding_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "attempt_artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "attempt_purpose": { "$ref": "common.schema.json#/$defs/AttemptPurpose" },
    "instance_nonce": { "type": "string", "pattern": "^[0-9a-f]{32,128}$" },
    "schedule_ordinal": { "type": "integer", "minimum": 0 }
  }
}
