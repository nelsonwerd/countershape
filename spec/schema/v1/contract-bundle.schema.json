{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/contract-bundle.schema.json",
  "title": "Countershape ContractBundle v1",
  "description": "A deterministic six-file Node-core source bundle for an exact selected-field predicate. It does not establish current conformance or semantic parity by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "artifact_digest", "decision_record_digest", "decision_action", "emitter_version",
    "target", "predicate", "artifacts", "node_core_only", "countershape_import_present", "package_registry_required",
    "determinism_profile", "standalone_absence_receipt"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "ContractBundle" },
    "artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "decision_record_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "decision_action": { "enum": ["ALLOW_OBSERVED", "CUSTOM_EXPECTATION"] },
    "emitter_version": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "major", "os", "semantic_profile"],
      "properties": {
        "runtime": { "const": "NODE" },
        "major": { "type": "integer", "minimum": 1 },
        "os": { "enum": ["darwin", "linux", "windows", "other"] },
        "semantic_profile": { "const": "countershape-node-core-exact/v1" }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "stimulus_digest", "selected_fields", "allowed_tuples"],
      "properties": {
        "kind": { "const": "one-of-exact/v1" },
        "scope": { "const": "EXACT_WITNESSED_STIMULUS" },
        "stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "selected_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/FieldId" }
        },
        "allowed_tuples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/ExactTuple" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "byte_digest", "byte_count"],
        "properties": {
          "name": { "enum": ["decision.json", "fixture.json", "contract.test.mjs", "harness.mjs", "README.md", "manifest.json"] },
          "byte_digest": { "$ref": "common.schema.json#/$defs/Digest" },
          "byte_count": { "type": "integer", "minimum": 1 }
        }
      },
      "allOf": [
        { "contains": { "properties": { "name": { "const": "decision.json" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "fixture.json" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "contract.test.mjs" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "harness.mjs" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "README.md" } }, "required": ["name"] } },
        { "contains": { "properties": { "name": { "const": "manifest.json" } }, "required": ["name"] } }
      ]
    },
    "node_core_only": { "const": true },
    "countershape_import_present": { "const": false },
    "package_registry_required": { "const": false },
    "determinism_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_time", "contains_random_id", "contains_absolute_path", "contains_candidate_identity", "contains_secret"],
      "properties": {
        "contains_time": { "const": false },
        "contains_random_id": { "const": false },
        "contains_absolute_path": { "const": false },
        "contains_candidate_identity": { "const": false },
        "contains_secret": { "const": false }
      }
    },
    "standalone_absence_receipt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "UNRECEIPTED" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "receipt"],
          "properties": {
            "status": { "const": "RECEIPTED" },
            "receipt": { "$ref": "common.schema.json#/$defs/ReceiptReference" }
          }
        }
      ]
    }
  }
}
