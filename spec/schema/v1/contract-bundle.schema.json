{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/contract-bundle.schema.json",
  "title": "Countershape ContractBundle v1",
  "description": "A deterministic recoverable six-file Node-core source bundle for one exact selected-field predicate. Its domain-separated artifact digest is external to this canonical body. The emitter invents neither current execution nor receipt authority; exact authorized input content is retained as data and is not content-scanned into a confidentiality claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "bundle_version",
    "decision_record_digest",
    "choicepoint_digest",
    "portable_source_digest",
    "portable_profile_digest",
    "decision_action",
    "emitter_version",
    "source_profile",
    "predicate",
    "files",
    "manifest_policy",
    "runtime_dependency_profile",
    "countershape_runtime_binding",
    "package_registry_binding",
    "environment_profile",
    "external_service_binding",
    "determinism_profile",
    "confidentiality_established"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "ContractBundle" },
    "bundle_version": { "const": "node-core-contract-bundle/v1" },
    "decision_record_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "choicepoint_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "portable_source_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "portable_profile_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "decision_action": { "enum": ["ALLOW_OBSERVED", "CUSTOM_EXPECTATION"] },
    "emitter_version": { "const": "node-exact-emitter/v1" },
    "source_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_family",
        "semantic_profile",
        "adapter_domain",
        "launch_profile",
        "subject_entrypoint",
        "start_profile",
        "scope"
      ],
      "properties": {
        "runtime_family": { "const": "NODE" },
        "semantic_profile": { "const": "countershape-node-core-exact/v1" },
        "adapter_domain": { "enum": ["CLI", "HTTP"] },
        "launch_profile": { "const": "NODE_REPO_SCRIPT_V1" },
        "subject_entrypoint": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.(?:js|mjs|cjs)$"
        },
        "start_profile": { "enum": ["DIRECT_CHILD_V1", "NODE_LOOPBACK_CHILD_BIND_PIPE_READY_V1"] },
        "scope": { "const": "DECLARED_SOURCE_PROFILE_NOT_EXECUTION_EVIDENCE" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "adapter_domain": { "const": "CLI" } },
            "required": ["adapter_domain"]
          },
          "then": { "properties": { "start_profile": { "const": "DIRECT_CHILD_V1" } } }
        },
        {
          "if": {
            "properties": { "adapter_domain": { "const": "HTTP" } },
            "required": ["adapter_domain"]
          },
          "then": {
            "properties": {
              "start_profile": { "const": "NODE_LOOPBACK_CHILD_BIND_PIPE_READY_V1" }
            }
          }
        }
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "stimulus_digest", "portable_profile_digest", "selected_fields", "allowed_tuples"],
      "properties": {
        "kind": { "const": "one-of-exact/v1" },
        "scope": { "const": "EXACT_WITNESSED_STIMULUS" },
        "stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "portable_profile_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "selected_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/FieldId" }
        },
        "allowed_tuples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ExactTuple" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "byte_count", "byte_sha256", "content_base64"],
        "properties": {
          "path": { "enum": ["README.md", "contract.test.mjs", "decision.json", "fixture.json", "harness.mjs", "manifest.json"] },
          "mode": { "const": "100644" },
          "byte_count": { "type": "integer", "minimum": 1, "maximum": 655360 },
          "byte_sha256": { "$ref": "common.schema.json#/$defs/Digest" },
          "content_base64": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        }
      },
      "allOf": [
        { "contains": { "properties": { "path": { "const": "README.md" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "contract.test.mjs" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "decision.json" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "fixture.json" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "harness.mjs" } }, "required": ["path"] } },
        { "contains": { "properties": { "path": { "const": "manifest.json" } }, "required": ["path"] } }
      ]
    },
    "manifest_policy": { "const": "COVERS_OTHER_FIVE_EXCLUDES_SELF_V1" },
    "runtime_dependency_profile": { "const": "NODE_CORE_ONLY_V1" },
    "countershape_runtime_binding": { "const": "ABSENT_BY_CONSTRUCTION" },
    "package_registry_binding": { "const": "NONE" },
    "environment_profile": { "const": "EXPLICIT_SPARSE_ALLOWLIST_V1" },
    "external_service_binding": { "const": "NONE" },
    "determinism_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "emitter_introduces_time",
        "emitter_introduces_random_id",
        "emitter_introduces_absolute_path",
        "emitter_introduces_concrete_candidate_identity",
        "emitter_introduces_declared_secret_value",
        "emitter_introduces_host_runtime_fact",
        "emitter_introduces_execution_receipt"
      ],
      "properties": {
        "scope": { "const": "EMITTER_INVENTED_STRUCTURAL_FACTS_EXCLUDING_AUTHORIZED_INPUT_CONTENT" },
        "emitter_introduces_time": { "const": false },
        "emitter_introduces_random_id": { "const": false },
        "emitter_introduces_absolute_path": { "const": false },
        "emitter_introduces_concrete_candidate_identity": { "const": false },
        "emitter_introduces_declared_secret_value": { "const": false },
        "emitter_introduces_host_runtime_fact": { "const": false },
        "emitter_introduces_execution_receipt": { "const": false }
      }
    },
    "confidentiality_established": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision_action": { "const": "CUSTOM_EXPECTATION" } },
        "required": ["decision_action"]
      },
      "then": {
        "properties": {
          "predicate": {
            "properties": {
              "allowed_tuples": { "minItems": 1, "maxItems": 1 }
            }
          }
        }
      }
    }
  ]
}
