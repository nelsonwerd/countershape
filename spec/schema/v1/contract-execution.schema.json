{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/contract-execution.schema.json",
  "title": "Countershape ContractExecution v1",
  "description": "Inert immutable nonhead classification body derived from one exact target, its matching finalized run, and the literal exact-tuple classifier profile. It contains no tuple, process reason, scope reason, self digest, current selector, or receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "execution_version",
    "publication_scope",
    "classifier_profile",
    "contract_execution_target_digest",
    "finalized_contract_run_digest",
    "result"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "ContractExecution" },
    "execution_version": { "const": "contract-execution/v1" },
    "publication_scope": { "const": "IMMUTABLE_NONHEAD_CLASSIFICATION_V1" },
    "classifier_profile": { "const": "CONTRACT_EXECUTION_EXACT_TUPLE_V1" },
    "contract_execution_target_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "finalized_contract_run_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "result": { "enum": ["CONFORMS", "CONTRADICTS", "INELIGIBLE_EXECUTION"] }
  }
}
