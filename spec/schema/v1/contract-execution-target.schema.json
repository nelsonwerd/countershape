{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/contract-execution-target.schema.json",
  "title": "Countershape ContractExecutionTarget v1",
  "description": "Inert canonical body for one immutable nonhead pre-spawn target. Its external typed digest and later store witness are not members of this body; parsing confers no publication or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "target_version",
    "publication_scope",
    "contract_bundle_digest",
    "terminal_residue_binding",
    "tree_binding",
    "attempt_binding",
    "boot_session_binding",
    "runtime_binding"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "ContractExecutionTarget" },
    "target_version": { "const": "contract-execution-target/v1" },
    "publication_scope": { "const": "IMMUTABLE_NONHEAD_PRESPAWN_AUTHORITY_V1" },
    "contract_bundle_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "terminal_residue_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "study_id",
        "head_revision",
        "head_digest",
        "lineage_root_digest",
        "stage",
        "current_kind",
        "current_digest"
      ],
      "properties": {
        "profile": { "const": "EXACT_TERMINAL_RESIDUE_HEAD_V1" },
        "study_id": { "type": "string", "pattern": "^study:[0-9a-f]{64}$" },
        "head_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "head_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "lineage_root_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "stage": { "const": "RESIDUE" },
        "current_kind": { "const": "ContractBundle" },
        "current_digest": { "$ref": "common.schema.json#/$defs/Digest" }
      }
    },
    "tree_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "object_format",
        "commit_oid",
        "tree_oid",
        "tree_identity_digest",
        "portable_tree_digest",
        "materialization_policy_digest",
        "materialization_manifest_digest",
        "execution_root_scope"
      ],
      "properties": {
        "authority": { "const": "GIT_PIN_INSPECT_MATERIALIZE_V1" },
        "object_format": { "enum": ["sha1", "sha256"] },
        "commit_oid": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
        "tree_oid": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
        "tree_identity_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "portable_tree_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "materialization_policy_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "materialization_manifest_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "execution_root_scope": { "const": "PRIVATE_PINNED_MATERIALIZATION_ONLY_V1" }
      },
      "allOf": [
        {
          "if": { "properties": { "object_format": { "const": "sha1" } }, "required": ["object_format"] },
          "then": {
            "properties": {
              "commit_oid": { "pattern": "^[0-9a-f]{40}$" },
              "tree_oid": { "pattern": "^[0-9a-f]{40}$" }
            }
          }
        },
        {
          "if": { "properties": { "object_format": { "const": "sha256" } }, "required": ["object_format"] },
          "then": {
            "properties": {
              "commit_oid": { "pattern": "^[0-9a-f]{64}$" },
              "tree_oid": { "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      ]
    },
    "attempt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "attempt_artifact_digest", "instance_nonce", "allocation_profile", "marker_ordering"],
      "properties": {
        "purpose": { "const": "CONFORMANCE" },
        "attempt_artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "instance_nonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "allocation_profile": { "const": "PRIVATE_FRESH_ROOT_V1" },
        "marker_ordering": { "const": "DURABLE_BEFORE_SPAWN" }
      }
    },
    "boot_session_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "identity_digest"],
      "properties": {
        "profile": { "const": "DARWIN_KERN_BOOTSESSIONUUID_V1" },
        "identity_digest": { "$ref": "common.schema.json#/$defs/Digest" }
      }
    },
    "runtime_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "name",
        "admitted_executable_path",
        "measured_process_exec_path",
        "version",
        "major",
        "platform",
        "architecture",
        "executable_identity",
        "probe_program_digest",
        "child_resolution"
      ],
      "properties": {
        "authority": { "const": "ADMITTED_NODE_PROCESS_EXEC_PATH_V1" },
        "name": { "const": "node" },
        "admitted_executable_path": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]+$" },
        "measured_process_exec_path": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/[^\\u0000-\\u001f\\u007f]+$" },
        "version": { "type": "string", "maxLength": 128, "pattern": "^v?[1-9][0-9]*\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$" },
        "major": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "platform": { "const": "darwin" },
        "architecture": { "const": "arm64" },
        "executable_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bytes_digest", "mode", "byte_count"],
          "properties": {
            "bytes_digest": { "$ref": "common.schema.json#/$defs/Digest" },
            "mode": { "type": "string", "pattern": "^100(?:[1357][0-7]{2}|[0-7][1357][0-7]|[0-7]{2}[1357])$" },
            "byte_count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        "probe_program_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "child_resolution": { "const": "PROCESS_EXEC_PATH_EQUALS_ADMITTED_RUNTIME_V1" }
      }
    }
  }
}
