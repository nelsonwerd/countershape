{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/stable-batch.schema.json",
  "title": "Countershape StableBatch v1",
  "description": "A policy-bounded batch whose wire trials retain their captured-or-controlled tags and structural evidence identities. duplicate_evidence_within_batch=false is a semantic constructor invariant over referenced evidence identities; it is never proof of a fresh host, process, filesystem, network, cache, or physical execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "artifact_digest", "candidate_execution_key",
    "candidate_execution_binding_digest", "world_plan_digest", "stimulus_digest",
    "comparison_envelope_digest", "comparison_admission_digests",
    "comparison_basis_digest", "comparison_admission_candidate_roster", "repeat_policy_digest",
    "required_fresh_trials", "schedule", "trials", "classification",
    "duplicate_evidence_within_batch"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "StableBatch" },
    "artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "candidate_execution_key": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" },
    "candidate_execution_binding_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "world_plan_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "comparison_envelope_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "comparison_admission_digests": {
      "description": "One per-repetition admitted-comparison artifact digest in schedule order. Peer candidate batches for one outcome map must carry the exact same ordered set.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "comparison_basis_digest": {
      "description": "Stimulus- and purpose-independent basis copied from the admitted comparison and checked by the semantic constructor.",
      "$ref": "common.schema.json#/$defs/Digest"
    },
    "comparison_admission_candidate_roster": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" }
    },
    "repeat_policy_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "required_fresh_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "rotation", "schedule_digest", "ordinals"],
      "properties": {
        "phase": { "$ref": "common.schema.json#/$defs/AttemptPurpose" },
        "rotation": { "const": "ROTATE_START_BY_REPETITION_V1" },
        "schedule_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "ordinals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/CapturedTrial" },
          { "$ref": "#/$defs/ControlledTrial" }
        ]
      }
    },
    "classification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "eligible_trials", "required_trials", "projection_fingerprint", "bounded_label"],
          "properties": {
            "status": { "const": "OBSERVED_STABLE" },
            "eligible_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
            "required_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
            "projection_fingerprint": { "$ref": "common.schema.json#/$defs/ProjectionFingerprint" },
            "bounded_label": { "type": "string", "pattern": "^OBSERVED_STABLE\\([1-5]/[1-5],sha256:[0-9a-f]{64}\\)$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "eligible_trials", "histogram"],
          "properties": {
            "status": { "const": "UNSTABLE" },
            "eligible_trials": { "type": "integer", "minimum": 2, "maximum": 5 },
            "histogram": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["projection_fingerprint", "count"],
                "properties": {
                  "projection_fingerprint": { "$ref": "common.schema.json#/$defs/ProjectionFingerprint" },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_codes"],
          "properties": {
            "status": { "const": "UNCOMPARABLE" },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/ControlReason" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "eligible_trials", "required_trials", "reason"],
          "properties": {
            "status": { "const": "INCOMPLETE" },
            "eligible_trials": { "type": "integer", "minimum": 0, "maximum": 4 },
            "required_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
            "reason": { "const": "BUDGET_EXHAUSTED" }
          }
        }
      ]
    },
    "duplicate_evidence_within_batch": { "const": false }
  },
  "$defs": {
    "TrialIdentity": {
      "type": "object",
      "required": ["ordinal", "world_instance_digest", "attempt_artifact_digest", "admission_token_digest"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "world_instance_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "attempt_artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "admission_token_digest": {
          "description": "Digest reference to the deterministic, internal, ephemeral admission token consumed for this attempt; the token body is not a durable wire artifact.",
          "$ref": "common.schema.json#/$defs/Digest"
        }
      }
    },
    "CapturedTrial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "disposition", "world_instance_digest", "attempt_artifact_digest", "comparison_admission_digest", "admission_token_digest", "captured", "control"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "disposition": { "const": "BEHAVIOR_CAPTURED" },
        "world_instance_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "attempt_artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "comparison_admission_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "admission_token_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "captured": {
          "type": "object",
          "additionalProperties": false,
          "required": ["captured_observation_digest", "projection_result_digest", "projection_fingerprint"],
          "properties": {
            "captured_observation_digest": { "$ref": "common.schema.json#/$defs/Digest" },
            "projection_result_digest": { "$ref": "common.schema.json#/$defs/Digest" },
            "projection_fingerprint": { "$ref": "common.schema.json#/$defs/ProjectionFingerprint" }
          }
        },
        "control": { "type": "null" }
      }
    },
    "ControlledTrial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "disposition", "world_instance_digest", "attempt_artifact_digest", "comparison_admission_digest", "admission_token_digest", "captured", "control"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 0 },
        "disposition": { "const": "CONTROL_OUTCOME" },
        "world_instance_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "attempt_artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "comparison_admission_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "admission_token_digest": { "$ref": "common.schema.json#/$defs/Digest" },
        "captured": { "type": "null" },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_codes"],
          "properties": {
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/ControlReason" }
            }
          }
        }
      }
    }
  }
}
