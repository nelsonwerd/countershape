{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/stable-batch.schema.json",
  "title": "Countershape StableBatch v1",
  "description": "Finite fresh-trial classification. OBSERVED_STABLE is evidence bounded by k and h, never a determinism claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "artifact_digest", "candidate_execution_key", "stimulus_digest",
    "comparison_envelope_digest", "required_fresh_trials", "schedule", "world_instance_digests",
    "attempt_artifact_digests", "captured_observation_digests", "projection_result_digests",
    "classification", "execution_evidence_reused"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "StableBatch" },
    "artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "candidate_execution_key": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" },
    "stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "comparison_envelope_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "required_fresh_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "rotation", "ordinals"],
      "properties": {
        "phase": { "enum": ["DISCOVERY", "REDUCTION", "FINAL_SWEEP", "CONFIRMATION", "CONFORMANCE"] },
        "rotation": { "const": "RECORDED_SEQUENTIAL" },
        "ordinals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "world_instance_digests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "attempt_artifact_digests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "captured_observation_digests": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "projection_result_digests": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/Digest" }
    },
    "classification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "eligible_trials", "required_trials", "projection_fingerprint", "bounded_label"],
          "properties": {
            "status": { "const": "OBSERVED_STABLE" },
            "eligible_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
            "required_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
            "projection_fingerprint": { "$ref": "common.schema.json#/$defs/Digest" },
            "bounded_label": { "type": "string", "pattern": "^OBSERVED_STABLE\\([1-5]/[1-5],sha256:[0-9a-f]{64}\\)$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "eligible_trials", "histogram"],
          "properties": {
            "status": { "const": "UNSTABLE" },
            "eligible_trials": { "type": "integer", "minimum": 2, "maximum": 5 },
            "histogram": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["projection_fingerprint", "count"],
                "properties": {
                  "projection_fingerprint": { "$ref": "common.schema.json#/$defs/Digest" },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_codes"],
          "properties": {
            "status": { "const": "UNCOMPARABLE" },
            "reason_codes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "common.schema.json#/$defs/ControlReason" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "eligible_trials", "required_trials", "reason"],
          "properties": {
            "status": { "const": "INCOMPLETE" },
            "eligible_trials": { "type": "integer", "minimum": 0, "maximum": 4 },
            "required_trials": { "type": "integer", "minimum": 1, "maximum": 5 },
            "reason": { "const": "BUDGET_EXHAUSTED" }
          }
        }
      ]
    },
    "execution_evidence_reused": { "const": false }
  }
}
