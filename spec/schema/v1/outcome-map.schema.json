{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://countershape.dev/spec/schema/v1/outcome-map.schema.json",
  "title": "Countershape OutcomeMap v1",
  "description": "The complete sorted candidate_execution_key to projection_fingerprint map. Display groups, ordinals, support counts, and branch labels have no identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "artifact_digest", "stimulus_digest", "comparison_envelope_digest",
    "entries", "excluded_candidates", "distinct_projection_count", "divergence", "entry_order",
    "identity_basis", "display_groups_semantic_authority", "majority_semantic_authority"
  ],
  "properties": {
    "schema_version": { "const": "countershape/v1" },
    "kind": { "const": "OutcomeMap" },
    "artifact_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "stimulus_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "comparison_envelope_digest": { "$ref": "common.schema.json#/$defs/Digest" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_execution_key", "projection_fingerprint", "stable_batch_digest"],
        "properties": {
          "candidate_execution_key": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" },
          "projection_fingerprint": { "$ref": "common.schema.json#/$defs/Digest" },
          "stable_batch_digest": { "$ref": "common.schema.json#/$defs/Digest" }
        }
      }
    },
    "excluded_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_execution_key", "stable_batch_digest", "classification"],
        "properties": {
          "candidate_execution_key": { "$ref": "common.schema.json#/$defs/CandidateExecutionKey" },
          "stable_batch_digest": { "$ref": "common.schema.json#/$defs/Digest" },
          "classification": { "enum": ["UNSTABLE", "UNCOMPARABLE", "INCOMPLETE"] }
        }
      }
    },
    "distinct_projection_count": { "type": "integer", "minimum": 1 },
    "divergence": { "type": "boolean" },
    "entry_order": { "const": "CANDIDATE_EXECUTION_KEY_UTF8_LEXICOGRAPHIC" },
    "identity_basis": { "const": "COMPLETE_SORTED_LABELED_MAP" },
    "display_groups_semantic_authority": { "const": false },
    "majority_semantic_authority": { "const": false }
  }
}
